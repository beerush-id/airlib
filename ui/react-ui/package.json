{
  "type": "module",
  "name": "@airlib/react-ui",
  "version": "1.0.0",
  "description": "React components for AIR MUI — Material Design 3 headless component library. Thin wrappers connecting @airlib/headless headless logic to React with fine-grained ARIA mapping.",
  "keywords": [
    "react",
    "material-design",
    "headless",
    "ui",
    "components",
    "air-stack",
    "anchor",
    "typescript"
  ],
  "author": "Nanang Mahdaen El Agung <mahdaen@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/beerush-id/airlib.git"
  },
  "bugs": {
    "url": "https://github.com/beerush-id/airlib/issues"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./lib": {
      "types": "./dist/lib/index.d.ts",
      "import": "./dist/lib/index.js"
    },
    "./components": {
      "types": "./dist/components/index.d.ts",
      "import": "./dist/components/index.js"
    },
    "./form": {
      "types": "./dist/form/index.d.ts",
      "import": "./dist/form/index.js"
    },
    "./icons": {
      "types": "./dist/icons/index.d.ts",
      "import": "./dist/icons/index.js"
    },
    "./utils": {
      "types": "./dist/utils/index.d.ts",
      "import": "./dist/utils/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "directories": {
    "dist": "dist"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/bun": "catalog:",
    "jsdom": "catalog:",
    "publint": "catalog:",
    "rimraf": "catalog:",
    "shiki": "catalog:lib",
    "tsdown": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@airlib/form": "workspace:*",
    "@airlib/headless": "workspace:*",
    "@airlib/core": "catalog:lib",
    "@airlib/react": "catalog:lib",
    "react": "catalog:lib",
    "react-dom": "catalog:lib",
    "typescript": "catalog:lib"
  },
  "scripts": {
    "dev": "tsdown --watch ./src",
    "clean": "rimraf dist",
    "build": "bun run clean && tsdown && publint",
    "prepublish": "bun run format && bun run build",
    "format": "biome format --write",
    "test:run": "rimraf coverage && vitest --run",
    "test:preview": "rimraf coverage && vitest --run && vite preview --outDir coverage"
  },
  "license": "MIT"
}