{
  "name": "airlib",
  "type": "module",
  "version": "1.2.0",
  "description": "Monorepo for AIR Libraries",
  "author": "Nanang Mahdaen El Agung <mahdaen@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/beerush-id/airlib.git"
  },
  "bugs": {
    "url": "https://github.com/beerush-id/airlib/issues"
  },
  "scripts": {
    "build": "bpkg run build",
    "dev": "bpkg run dev",
    "format": "bpkg run format",
    "lint": "bpkg run lint",
    "prepublish": "bpkg run prepublish -f irpc/* packages/* ui/* --sequential",
    "test": "rimraf docs/.vitepress/dist/coverage && vitest --run",
    "test:all": "rimraf docs/.vitepress/dist/coverage && vitest --run",
    "test:preview": "rimraf docs/.vitepress/dist/coverage && vitest --run && vite preview --outDir docs/.vitepress/dist/coverage"
  },
  "devDependencies": {
    "@anchorlib/react": "catalog:",
    "@biomejs/biome": "catalog:",
    "@irpclib/irpc": "catalog:",
    "@tailwindcss/language-server": "catalog:",
    "@types/markdown-it-container": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "@vitest/ui": "catalog:",
    "markdown-it-container": "catalog:",
    "monopkg": "catalog:",
    "react": "catalog:lib",
    "react-dom": "catalog:lib",
    "rimraf": "catalog:",
    "vite-plugin-solid": "catalog:",
    "vitepress": "catalog:",
    "vitepress-plugin-llms": "catalog:",
    "vitepress-plugin-sandpack": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "packageManager": "bun@1.3.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "ui/*",
    "irpc/*",
    "demos/*"
  ],
  "catalogs": {
    "lib": {
      "@anchorlib/core": "1.2.0",
      "@anchorlib/react": "1.2.0",
      "@anchorlib/solid": "1.2.0",
      "@irpclib/http": "1.2.0",
      "@irpclib/irpc": "1.2.0",
      "@irpclib/ws": "1.2.0",
      "react": "^19.1.0",
      "react-dom": "^19.1.0",
      "solid-js": "^1.9.0",
      "tailwindcss": "4.3.0",
      "typescript": "6.0.3",
      "zod": "^4.1.5"
    }
  },
  "catalog": {
    "@anchorlib/core": "1.2.0",
    "@anchorlib/react": "1.2.0",
    "@anchorlib/solid": "1.2.0",
    "@anchorlib/vite-ssr": "1.2.0",
    "@biomejs/biome": "^2.3.0",
    "@irpclib/http": "1.2.0",
    "@irpclib/irpc": "1.2.0",
    "@irpclib/ws": "1.2.0",
    "@solidjs/testing-library": "^0.8.10",
    "@tailwindcss/language-server": "^0.14.0",
    "@tailwindcss/vite": "4.3.0",
    "@testing-library/jest-dom": "^6.9.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.0",
    "@testing-library/vue": "^8.1.0",
    "@types/bun": "^1.3.0",
    "@types/markdown-it-container": "^2.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/coverage-v8": "^3.2.0",
    "@vitest/ui": "^3.2.0",
    "bun-plugin-tailwind": "^0.1.0",
    "globals": "^16.4.0",
    "jsdom": "^27.0.0",
    "markdown-it-container": "^4.0.0",
    "monopkg": "^0.5.0",
    "publint": "^0.3.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "rimraf": "^6.0.0",
    "solid-js": "^1.9.0",
    "tailwindcss": "^4.3.0",
    "tsdown": "^0.15.0",
    "typescript": "6.0.3",
    "unplugin-solid": "1.0.0",
    "vite": "^8.0.0",
    "vite-plugin-devtools-json": "^1.0.0",
    "vite-plugin-solid": "^2.11.10",
    "vite-tsconfig-paths": "^5.1.0",
    "vitepress": "^1.6.0",
    "vitepress-plugin-llms": "^1.8.0",
    "vitepress-plugin-sandpack": "^1.1.0",
    "vitest": "^3.2.0",
    "zod": "^4.1.0"
  }
}