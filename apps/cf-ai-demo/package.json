{
  "name": "cf-ai-demo",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "description": "AIR Stack for React — Vite SSR Starter",
  "scripts": {
    "dev": "vite",
    "build:client": "vite build --outDir dist/client",
    "build:server": "vite build --ssr src/worker.ts --outDir dist/server",
    "build": "bun run build:client && bun run build:server",
    "start": "NODE_ENV=production bun dist/server/worker.js",
    "preview": "vite preview --outDir dist/client"
  },
  "dependencies": {
    "@airlib/material": "workspace:*",
    "@airlib/react-form": "workspace:*",
    "@airlib/react-ui": "workspace:*",
    "@airlib/headless": "workspace:*",
    "@airlib/core": "catalog:app",
    "@airlib/react": "catalog:app",
    "@airlib/storage": "catalog:app",
    "@irpclib/http": "catalog:app",
    "@irpclib/irpc": "catalog:app",
    "@irpclib/ws": "catalog:app",
    "react": "catalog:app",
    "react-dom": "catalog:app",
    "zod": "catalog:app"
  },
  "devDependencies": {
    "@airlib/vite": "catalog:app",
    "@biomejs/biome": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@types/bun": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:"
  }
}